@page "/discover"
@using OutreachFlow.Services.Discovery
@inject OpportunityDiscoveryService Discovery
<PageTitle>Discover · OutreachFlow</PageTitle>

<section class="page-header">
    <div>
        <div class="eyebrow">SEARCH-INDEX DISCOVERY</div>
        <h1>Discover opportunities</h1>
        <p>Search for potential official processes using your active workspace profile. All results remain unverified until you inspect their sources.</p>
    </div>
</section>

<section class="panel spaced">
    <div class="panel-heading">
        <h2>On-demand web discovery</h2>
        <small>@Discovery.ProviderName</small>
    </div>
    @if (!Discovery.IsSearchConfigured)
    {
        <p>Search isn't configured. The application owner can enable it with a server-side Tavily API key. No key is needed from workspace users.</p>
    }
    else
    {
        <p>Each click submits up to two basic web searches, each returning at most five indexed results. This does not use an LLM or automatically contact anyone.</p>
    }
    @if (budget is not null)
    {
        <p><strong>Application search budget:</strong> @budget.Remaining of @budget.Limit requests remaining for @budget.MonthUtc (UTC), shared by all workspaces.</p>
    }
    <div class="actions">
        <button class="button primary" @onclick="RunSearch" disabled="@(busy || !Discovery.IsSearchConfigured)">
            @(busy ? "Searching…" : "Search using workspace profile")
        </button>
        <a class="button" href="/settings">Edit research keywords</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(notice)) { <div class="notice">@notice</div> }
</section>

@if (batch is not null)
{
    <section class="panel spaced">
        <div class="panel-heading">
            <h2>Indexed candidates — manual review</h2>
            <small>@batch.Candidates.Count suggestions · @batch.RetrievedUtc.ToString("u")</small>
        </div>
        <p class="help">The app groups indexed results by a deterministic, explainable next-step suggestion. It never verifies that a source is official or that an application, contract or inquiry is appropriate. Inspect the source and approve or override the recommendation before saving.</p>
        <p class="help">Relevance scores reflect keyword matches, not confidence or opportunity availability. Low-priority results remain visible rather than being discarded.</p>
        @foreach (var query in batch.Queries) { <p><small>Query: @query</small></p> }
        @foreach (var warning in batch.Warnings) { <p class="notice">@warning</p> }
        @if (batch.Candidates.Count == 0) { <p>No candidates were returned. This does not mean that no opportunities exist.</p> }
        @foreach (var nextStep in OpportunityTriage.DisplayOrder)
        {
            var candidates = batch.Candidates.Where(c => c.Suggestion.Step == nextStep).ToArray();
            @if (candidates.Length > 0)
            {
                <h3>@OpportunityTriage.Label(nextStep) (@candidates.Length)</h3>
                @foreach (var candidate in candidates)
                {
                    <div class="evidence">
                        <strong>@candidate.Title</strong>
                        <p><small>Relevance @candidate.RelevanceScore / 100 · @candidate.Host · @candidate.SourceTier</small></p>
                        <p><strong>Intent hint:</strong> @candidate.IntentCategory</p>
                        <p class="help">@candidate.RankingReason</p>
                        <p><strong>Suggested next step:</strong> @candidate.Suggestion.Label</p>
                        <p class="help">@candidate.Suggestion.Explanation</p>
                        <a href="@candidate.Url" target="_blank" rel="noopener noreferrer">Inspect original result</a>
                        <p>@candidate.Summary</p>
                        @if (candidate.Suggestion.Route is DiscoveryRoute suggestedRoute)
                        {
                            <div class="actions">
                                <button class="button primary" @onclick="() => Route(candidate, suggestedRoute)" disabled="@busy">Approve suggested route</button>
                                <button class="button" @onclick="() => ToggleOverride(candidate.Url)" disabled="@busy">@(overrideUrls.Contains(candidate.Url) ? "Hide alternative routes" : "Choose a different route")</button>
                            </div>
                        }
                        else
                        {
                            <p class="help">This result was deprioritized, not deleted. Review before changing its disposition.</p>
                            <button class="button" @onclick="() => ToggleOverride(candidate.Url)" disabled="@busy">@(overrideUrls.Contains(candidate.Url) ? "Hide alternatives" : "Override and review this result")</button>
                        }
                        @if (overrideUrls.Contains(candidate.Url))
                        {
                            <div class="actions">
                                <button class="button" @onclick="() => Route(candidate, DiscoveryRoute.FurtherResearch)" disabled="@busy">Research further</button>
                                <button class="button" @onclick="() => Route(candidate, DiscoveryRoute.ApplicationReview)" disabled="@busy">Review application process</button>
                                <button class="button" @onclick="() => Route(candidate, DiscoveryRoute.InquiryReview)" disabled="@busy">Review inquiry eligibility</button>
                            </div>
                        }
                    </div>
                }
            }
        }
    </section>
}

@code {
    private OpportunityDiscoveryBatch? batch;
    private SearchBudgetSnapshot? budget;
    private bool busy;
    private string notice = "";
    private readonly HashSet<string> overrideUrls = new(StringComparer.OrdinalIgnoreCase);

    private void ToggleOverride(string url)
    {
        if (!overrideUrls.Add(url)) overrideUrls.Remove(url);
    }

    protected override async Task OnInitializedAsync()
    {
        try { budget = await Discovery.GetBudgetAsync(); }
        catch (Exception ex) { notice = "Search budget unavailable: " + ex.Message; }
    }

    private async Task RunSearch()
    {
        busy = true;
        notice = "";
        batch = null;
        overrideUrls.Clear();
        try
        {
            batch = await Discovery.DiscoverAsync();
            budget = batch.Budget;
            notice = $"Research suggestions retrieved from {batch.ProviderName}. Confirm or override each suggested route after inspecting its source.";
        }
        catch (Exception ex)
        {
            notice = "Discovery could not finish: " + ex.Message;
            try { budget = await Discovery.GetBudgetAsync(); } catch { /* Ledger failure is already visible. */ }
        }
        finally { busy = false; }
    }

    private async Task Route(OpportunityCandidate candidate, DiscoveryRoute route)
    {
        if (batch is null) return;
        busy = true;
        try
        {
            var result = await Discovery.RouteReviewedAsync(batch.WorkspaceId, candidate, route);
            notice = result.Added
                ? "Added to the selected review queue. Indexed evidence remains unverified; no email or application was submitted."
                : "This source already exists in your workspace; its review status was not changed.";
        }
        catch (Exception ex) { notice = "Import failed: " + ex.Message; }
        finally { busy = false; }
    }
}
